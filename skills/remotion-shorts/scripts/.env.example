# Tous les réglages sont facultatifs. Copie ce fichier en .env pour en changer.
# Le fichier .env n'est jamais versionné.

# Logo en haut de l'image : NOM en blanc, ACCENT en couleur (peut être remplacé par "marque" dans script.json)
MARQUE_NOM=MA
MARQUE_ACCENT=CHAINE

# Dossier d'écriture des MP4, PNG et plans (défaut : sortie\ à côté du moteur)
DOSSIER_SORTIE=

# Dossier de clips verticaux (mp4, mov, webm) ; les mots-clés viennent du nom des fichiers
BIBLIOTHEQUE_FONDS=
# Fichier ou dossier de musique dont tu as les droits
MUSIQUE=
VOLUME_MUSIQUE=0.12

# Rythme et durée
DUREE_MIN_CIBLE=30
RYTHME_FONDS=2.2
BARRE_PROGRESSION=true
BOUCLE=true

# Rendu
CRF=18
CONCURRENCE=
# Chemin d'un Chrome ou Chromium déjà installé (sinon Remotion télécharge le sien, ~100 Mo)
NAVIGATEUR=
