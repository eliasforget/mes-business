# Copier en .env dans ce dossier :  Copy-Item .env.example .env
# En ligne, ces valeurs viennent des « Variables » du dépôt GitHub (Settings > Secrets and variables > Actions > Variables).
# Tout est facultatif : sans valeur, le site se construit sans mesure d'audience et sans adresse de contact.

# Adresse du site en ligne (sert aux liens UTM et au domaine surveillé par Umami), sans « / » final.
SITE_URL=https://checklist-gta6.pages.dev

# Adresse de contact affichée dans le pied de page et les mentions légales (adresse dédiée, pas la principale).
CONTACT_EMAIL=

# Mesure d'audience Umami : identifiant du site (Umami Cloud > Settings > Websites > Edit > Tracking code).
# Vide = aucun script de mesure n'est ajouté à la page.
UMAMI_WEBSITE_ID=
# URL du script affichée par Umami (elle dépend de la région choisie).
UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js
