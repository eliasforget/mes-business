# Réglages communs à tous les outils.
# Copier en .env (jamais versionné) :  Copy-Item .env.example .env
# Chaque outil peut avoir son propre .env dans son dossier (prioritaire sur celui-ci).

# Niveau de log : debug | info | warn | error
LOG_LEVEL=info

# Dossier des logs. Vide = <dépôt>\logs
LOG_DIR=
