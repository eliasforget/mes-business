# Copier en .env dans ce dossier :  Copy-Item .env.example .env
# Toutes les valeurs sont facultatives (valeurs par défaut ci-dessous).
# Les options de la ligne de commande (--cotes, --decote...) passent avant ce fichier.

# Ligues : F1 Ligue 1, F2 Ligue 2, E0 Premier League, E1 Championship, SP1 LaLiga,
#          I1 Serie A, D1 Bundesliga, N1 Eredivisie, P1 Liga Portugal
LIGUES=F1,E0,SP1,I1,D1
# Saisons au format football-data : 2425 = 2024/25
SAISONS=2122,2223,2324,2425,2526

# Dossiers (vides = data\ et resultats\ dans ce dossier)
DATA_DIR=
OUTPUT_DIR=

# Stratégies : favori, value_pinnacle, poisson, tirs, mixte
STRATEGIES=favori,value_pinnacle,poisson,tirs,mixte
# Avantage minimum exigé pour parier (0.03 = 3 %)
SEUIL_VALUE=0.03
# poisson et tirs
SEUIL_MODELE=0.05
SEUIL_MIXTE=0.03
# Part du modèle « tirs » dans la stratégie mixte (0 = Pinnacle seul, 1 = modèle seul)
POIDS_MODELE=0.3

# Cotes auxquelles on « parie » : avg (moyenne marché), max (meilleure cote), b365, ps (Pinnacle)
SOURCE_COTES=avg
# Décote appliquée aux cotes pour simuler un bookmaker français (0.05 = cotes 5 % moins bonnes)
DECOTE=0
# Ne parie que sur des cotes dans cette fourchette
COTE_MIN=1.2
COTE_MAX=8

# Gestion de la mise : fixe (MISE € par pari) ou kelly (fraction de Kelly, plafonnée à 5 % de la bankroll)
MODE_MISE=fixe
MISE=10
FRACTION_KELLY=0.25
BANKROLL=1000
