# Copier en .env dans ce dossier :  Copy-Item .env.example .env
# Tout est facultatif.

# Dossier de clips de fond (mp4 verticaux). Vide = bibliotheque\ dans ce dossier.
# Les mots-clés d'un clip viennent de son nom : miami-nuit-neons-01.mp4 -> miami, nuit, neons.
BIBLIOTHEQUE_FONDS=

# Musique : musique.mp3 dans le dossier de la vidéo, sinon un morceau du dossier musique\ de vr-video
# (choisi d'après le nom de la vidéo : chaque vidéo garde le sien, les suivantes varient).
# MUSIQUE peut pointer vers un autre fichier ou dossier.
MUSIQUE=
# Volume de la musique sous la voix (0 à 1)
VOLUME_MUSIQUE=0.12

# Durée minimale visée (secondes) : avertissement si la vidéo est plus courte
DUREE_MIN_CIBLE=30

# Un changement de plan de fond toutes les X secondes (le tout premier plan dure 1,3 s)
RYTHME_FONDS=2.2

# Habillage
MARQUE_NOM=VICE
MARQUE_ACCENT=RADAR
BARRE_PROGRESSION=true
BOUCLE=true

# Qualité H.264 (18 = très bon, 23 = plus léger)
CRF=18
# Nombre de rendus en parallèle (vide = moitié des cœurs du processeur)
CONCURRENCE=
# Navigateur à utiliser (vide = Remotion télécharge le sien au premier rendu)
NAVIGATEUR=
# Dossier des vidéos rendues (vide = sortie\ dans ce dossier)
DOSSIER_SORTIE=
