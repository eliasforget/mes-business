# Copier en .env dans ce dossier :  Copy-Item .env.example .env

# OBLIGATOIRE : clé gratuite sur https://www.pexels.com/api/ (bouton « Your API Key »)
PEXELS_API_KEY=

# Dossier de la bibliothèque (vide = tools\vr-video\bibliotheque, là où vr-video cherche)
BIBLIOTHEQUE_FONDS=

# Clips téléchargés par scène
CLIPS_PAR_SCENE=3
# Mots-clés utilisés pour les scènes sans « motsCles », à tour de rôle (séparés par des virgules)
MOTS_CLES_PAR_DEFAUT=miami nuit,neons ville,voiture de sport,palmiers floride

# Durée des clips acceptés (secondes) et poids maximum (Mo)
DUREE_MIN=5
DUREE_MAX=60
MAX_MO=80
# On s'arrête quand il reste moins de X requêtes Pexels ce mois-ci (quota gratuit : 20 000/mois)
RESERVE_REQUETES=50
