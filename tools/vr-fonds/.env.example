# Copier en .env dans ce dossier :  Copy-Item .env.example .env

# OBLIGATOIRE : clé gratuite affichée sur https://pixabay.com/api/docs/ une fois connecté (paramètre « key »)
PIXABAY_API_KEY=

# Dossier de la bibliothèque (vide = tools\vr-video\bibliotheque, là où vr-video cherche)
BIBLIOTHEQUE_FONDS=

# Clips téléchargés par scène
CLIPS_PAR_SCENE=3
# Mots-clés utilisés pour les scènes sans « motsCles », à tour de rôle (séparés par des virgules)
MOTS_CLES_PAR_DEFAUT=miami nuit,neons ville,voiture de sport,palmiers floride

# Durée des clips acceptés (secondes) et poids maximum d'un fichier (Mo)
DUREE_MIN=5
DUREE_MAX=60
MAX_MO=120

# Pixabay a peu de vidéos verticales : « oui » complète avec des vidéos horizontales en 4K,
# recadrées en 9:16 par vr-video (elles restent nettes). « non » = verticales uniquement.
ACCEPTER_PAYSAGE=oui
