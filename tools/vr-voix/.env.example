# Copier en .env dans ce dossier :  Copy-Item .env.example .env

# OBLIGATOIRE : elevenlabs.io > Profil (en bas à gauche) > API Keys
ELEVENLABS_API_KEY=
# OBLIGATOIRE : identifiant de la voix (liste : npm run voix -- --lister)
ELEVENLABS_VOIX_ID=

# Modèle : eleven_multilingual_v2 (meilleure qualité en français, 1 crédit/caractère)
#          eleven_flash_v2_5 (plus rapide, 0,5 crédit/caractère, un peu moins naturel)
ELEVENLABS_MODELE=eleven_multilingual_v2

# Réglages de la voix (0 à 1). Stabilité basse = plus expressif, plus variable.
STABILITE=0.45
SIMILARITE=0.8
# Style : exagère l'intonation (0 = neutre). 0,3-0,4 pour des « infos choc ».
STYLE=0.35
BOOST_LOCUTEUR=true
# Vitesse de lecture (0,7 à 1,2). Un Short gagne à être un peu rapide.
VITESSE=1.05
