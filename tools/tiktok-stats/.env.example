# Copier en .env dans ce dossier puis remplir avec notepad .env
# Clés de ton appli sur developers.tiktok.com (page de l'appli > Client key / Client secret). Jamais ailleurs que dans ce .env.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Port du petit serveur local qui reçoit l'autorisation : l'adresse de redirection à déclarer dans Login Kit (ordinateur)
# est http://localhost:3455/callback/
TIKTOK_PORT=3455

# Où écrire tiktok-stats.txt quand tu lances l'outil à la main (l'usine passe --sortie vers « A publier » toute seule)
DOSSIER_SORTIE=

# Nombre de vidéos lues par compte (20 par appel)
MAX_VIDEOS=60
