# Copier en .env dans ce dossier :  Copy-Item .env.example .env

# OBLIGATOIRE : clé gratuite sur https://the-odds-api.com (plan Starter, 500 crédits/mois, sans carte)
ODDS_API_KEY=

# Compétitions à surveiller (codes The Odds API ; liste : py main.py sports)
# Budget : 1 crédit par compétition et par scan + 2 crédits par compétition à régler.
# 5 compétitions scannées 1 fois/jour ≈ 150 à 450 crédits/mois selon le nombre de paris à régler.
SPORTS=soccer_france_ligue_one,soccer_epl,soccer_spain_la_liga,soccer_italy_serie_a,soccer_germany_bundesliga

# Bookmakers agréés en France comparés à Pinnacle (10 maximum, Pinnacle compris : au-delà, 2 crédits par appel)
BOOKMAKERS_FR=betclic_fr,winamax_fr,unibet_fr,pmu_fr,parionssport_fr,netbet_fr

# Avantage minimum pour noter un pari fictif (0.03 = la cote FR dépasse la cote juste de 3 %)
SEUIL=0.03
# Mise fictive par pari, en euros
MISE=10
COTE_MIN=1.2
COTE_MAX=8
# Ne regarde que les matchs qui commencent dans les X prochaines heures
HORIZON_HEURES=48
# Ignore les cotes plus vieilles que X minutes (une cote figée donne une fausse value)
AGE_MAX_MINUTES=60
# Ne descend jamais sous ce nombre de crédits restants
CREDITS_RESERVE=25

# Journal des paris fictifs (vide = data\journal.csv dans ce dossier)
JOURNAL=
