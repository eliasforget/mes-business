# Copier en .env dans ce dossier :  Copy-Item .env.example .env
# Tout est facultatif. Les clés ElevenLabs et Pixabay restent dans tools\vr-voix\.env et tools\vr-fonds\.env.

# Interrupteur général : false = l'usine ne fait plus rien (le Planificateur peut rester actif)
USINE_ACTIVE=true

# Où ranger les vidéos finies avec leurs textes (vide = Vidéos\A publier dans ton dossier utilisateur)
# Un sous-dossier par chaîne : A publier\Vice Radar\08-secrets-partie-4\ (mp4 + publication.txt)
# Conseillé : un dossier Google Drive (Google Drive pour ordinateur), pour récupérer les vidéos sur ton téléphone
# et voir les liens de téléchargement dans le tableau de bord. Exemple : G:\Mon Drive\Mes business\A publier
DOSSIER_A_PUBLIER=

# Dossier où tu déposes tes captures PS5 (vide = tools\vr-clips\entree). Conseillé : un dossier Google Drive,
# pour les déposer depuis ton téléphone. Chaque capture devient une vidéo gameplay, dans l'ordre de tools\vr-clips\tournage.json.
# Exemple : DOSSIER_CAPTURES=G:\Mon Drive\Mes business\Captures PS5
DOSSIER_CAPTURES=

# Garde-fous sur les crédits ElevenLabs (environ 600 à 700 caractères par vidéo)
MAX_PAR_PASSAGE=3
MAX_PAR_JOUR=4

# git pull automatique avant chaque passage, et rapport des vidéos prêtes poussé sur GitHub pour les agents
GIT_AUTO=true
POUSSER_RAPPORT=true
