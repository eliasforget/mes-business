# Copier en .env dans ce dossier :  Copy-Item .env.example .env
# Tout est facultatif.

# Dossier où tu déposes les captures PS5 téléchargées depuis l'appli PS App (ou copiées depuis une clé USB).
# Vide = le dossier entree\ de vr-clips. Les captures d'origine ne sont jamais déplacées ni modifiées.
CLIPS_ENTREE=

# Liste de tournage de la semaine (vide = tournage.json de vr-clips)
TOURNAGE=

# Où créer les dossiers de vidéo (vide = tools\vr-video\videos)
DOSSIER_VIDEOS=
